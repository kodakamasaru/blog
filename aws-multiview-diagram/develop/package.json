{
  "name": "tfscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "terraform plan から視点を切り替えられる構成図を生成するプロトタイプ",
  "scripts": {
    "plan": "cd infra && terraform init -input=false && terraform plan -input=false -refresh=false -out=plan.out && terraform show -json plan.out > plan.json",
    "model": "node tf2model/cli.mjs infra/plan.json infra > viewer/public/model.json",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test 'tf2model/*.test.mjs' 'viewer/src/*.test.js' 'scripts/*.test.mjs'",
    "record": "node scripts/record-demo.mjs",
    "icons": "node scripts/copy-icons.mjs",
    "samples": "node scripts/samples.mjs"
  },
  "dependencies": {
    "cytoscape": "^3.34.4",
    "cytoscape-elk": "^2.3.0",
    "elkjs": "^0.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "aws-icons": "^3.3.0",
    "vite": "^6.4.4"
  }
}
